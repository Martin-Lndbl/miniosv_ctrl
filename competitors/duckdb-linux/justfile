set shell := ["bash", "-euo", "pipefail", "-c"]

# The root .env, the login, the gateway endpoint and the bucket-policy grant
# are the same four steps in every S3 bench, so they come from there; what is
# left below is this bench's own: which binary, at which version, under which
# prefix. Shared with apps/bench/duckdb-tpch -- same bucket, same TPC-H data,
# same endpoint -- and this bench only adds one more grant to it.
common := justfile_directory() / "../../scripts/bench-setup.sh"
bin_prefix := "bin/duckdb-linux"
duckdb_version := "1.5.5"

# List available recipes
default:
    @just --list

# Fetch the official duckdb CLI + httpfs extension (linux_amd64_musl, so it
# needs no libc match on the instance) and upload them, unsigned via the VPCE
setup:
    #!/usr/bin/env bash
    set -euo pipefail

    . "{{ common }}"
    bench_env_load
    bench_login

    tmpdir=$(mktemp -d)
    trap 'rm -rf "$tmpdir"' EXIT

    # Not the "-musl" release: that one is dynamically linked against musl's
    # own loader (/lib/ld-musl-x86_64.so.1), which a glibc distro like AL2023
    # does not have -- exec then fails ENOENT, confusingly against the
    # binary's own path rather than the missing interpreter's. Plain
    # linux-amd64 links against the glibc AL2023 actually ships.
    echo "fetching duckdb {{ duckdb_version }} (linux_amd64, glibc)"
    curl -sL "https://github.com/duckdb/duckdb/releases/download/v{{ duckdb_version }}/duckdb_cli-linux-amd64.gz" \
        | gunzip > "$tmpdir/duckdb"
    chmod +x "$tmpdir/duckdb"

    echo "fetching httpfs extension for the same platform/version"
    curl -sL "http://extensions.duckdb.org/v{{ duckdb_version }}/linux_amd64/httpfs.duckdb_extension.gz" \
        | gunzip > "$tmpdir/httpfs.duckdb_extension"

    echo "uploading to s3://$AWS_BUCKET/{{ bin_prefix }}/"
    aws s3 cp "$tmpdir/duckdb" "s3://$AWS_BUCKET/{{ bin_prefix }}/duckdb" --only-show-errors
    aws s3 cp "$tmpdir/httpfs.duckdb_extension" \
        "s3://$AWS_BUCKET/{{ bin_prefix }}/httpfs.duckdb_extension" --only-show-errors

    # Merged by Sid, same as every other bench sharing this bucket.
    bench_grant DuckdbLinuxBinFromVpce "arn:aws:s3:::$AWS_BUCKET/{{ bin_prefix }}/*"

    echo
    echo "duckdb-linux ready:"
    echo "  s3://$AWS_BUCKET/{{ bin_prefix }}/duckdb"
    echo "  s3://$AWS_BUCKET/{{ bin_prefix }}/httpfs.duckdb_extension"

# Build the socket-phase shim the netphase knob LD_PRELOADs into duckdb, check
# it asks nothing newer than AL2023's glibc 2.34, and upload it beside the binary
setup-netphase:
    #!/usr/bin/env bash
    set -euo pipefail

    . "{{ common }}"
    bench_env_load
    bench_login

    tmpdir=$(mktemp -d)
    trap 'rm -rf "$tmpdir"' EXIT
    ${CC:-cc} -O2 -Wall -Wextra -shared -fPIC \
        -o "$tmpdir/netphase.so" "{{ justfile_directory() }}/netphase/netphase.c" -ldl
    # A nix cc wrapper bakes store paths into RUNPATH; harmless on AL2023
    # (the loader falls through to the default path) but strip it when we can.
    if command -v patchelf >/dev/null; then patchelf --remove-rpath "$tmpdir/netphase.so"; fi
    newest=$(readelf --dyn-syms -W "$tmpdir/netphase.so" | grep -o 'GLIBC_[0-9.]*' | sort -uV | tail -1)
    if [ "$(printf '%s\nGLIBC_2.34\n' "$newest" | sort -V | tail -1)" != GLIBC_2.34 ]; then
        echo "netphase.so needs $newest; AL2023 has GLIBC_2.34" >&2
        exit 1
    fi
    aws s3 cp "$tmpdir/netphase.so" "s3://$AWS_BUCKET/{{ bin_prefix }}/netphase.so" --only-show-errors
    echo "netphase.so uploaded to s3://$AWS_BUCKET/{{ bin_prefix }}/ (needs $newest)"

# Remove this bench's objects and its bucket-policy grant (not the bucket)
clean:
    #!/usr/bin/env bash
    set -euo pipefail
    . "{{ common }}"
    bench_env_load
    aws s3 rm "s3://$AWS_BUCKET/{{ bin_prefix }}/" --recursive
    bench_revoke DuckdbLinuxBinFromVpce
